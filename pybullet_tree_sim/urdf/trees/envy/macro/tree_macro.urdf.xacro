<?xml version="1.0"?>
<robot name="tree" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="tree_macro" params="
        tree_id
        tree_type
        namespace
        parent:=^|world
        use_visual_material:=true
        *origin
        ">

        <xacro:property name="mass" value="8.0" />
        <xacro:property name="scale" value="1 1 1"/>

        <link name="${namespace}_${tree_type}_${str(tree_id).zfill(5)}">
            <visual>
                <geometry>
                    <mesh filename="../../../../meshes/trees/${tree_type}/unlabeled/obj/${namespace}_${tree_type}_${str(tree_id).zfill(5)}.obj" scale="${scale}"/>
                </geometry>
                <!-- Omit material when false so PyBullet applies per-group map_Kd from OBJ/MTL (v2 export). -->
                <xacro:if value="${ str(use_visual_material).lower() in ('true', '1', 'yes') }">
                    <material name="LightGrey">
                        <color rgba="0.7 0.7 0.7 1.0"/>
                    </material>
                </xacro:if>
            </visual>
            <collision concave="true">
                <geometry>
                    <mesh filename="../../../../meshes/trees/${tree_type}/unlabeled/obj/${namespace}_${tree_type}_${str(tree_id).zfill(5)}.obj" scale="${scale}"/>
                </geometry>
            </collision>
                <inertial>
                <mass value="${mass}"/>
                <xacro:insert_block name="origin"/>
                <inertia ixx="0.00443333156" ixy="0.0" ixz="0.0" iyy="0.00443333156" iyz="0.0" izz="0.0072"/>
            </inertial>
        </link>
        <link name="world"/>
        <joint name="${namespace}_${tree_type}_${str(tree_id).zfill(5)}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${namespace}_${tree_type}_${str(tree_id).zfill(5)}"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </joint>

    </xacro:macro>
</robot>
